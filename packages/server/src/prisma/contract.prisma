// use prisma-8
model Product {
  @@map("products")
  id          Int          @id @default(autoincrement())
  name        VarChar(255)
  description String?
  price       Float
  reviews     Review[]
  summary     Summary?
}

model Review {
  @@map("reviews")
  id        Int          @id @default(autoincrement())
  author    VarChar(255)
  rating    SmallInt
  content   String
  createdAt DateTime     @default(now())
  productId Int
  product   Product      @relation(fields: [productId], references: [id])
}

model Summary {
  @@map("summaries")
  id          Int      @id @default(autoincrement())
  content     String
  generatedAt DateTime @default(now())
  expiresAt   DateTime
  productId   Int      @unique
  product     Product  @relation(fields: [productId], references: [id])
}
